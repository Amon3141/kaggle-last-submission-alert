{
  "manifest_version": 3,
  "name": "Kaggle残り提出回数警告",
  "version": "1.0",
  "description": "Kaggleで今日の提出回数が残り1回の時に警告を表示します。",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.kaggle.com/competitions/*", "https://www.kaggle.com/c/*"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}
